<idea-plugin>
    <id>dev.copal.jetbrains</id>
    <name>Copal.dev</name>
    <vendor url="https://copal.lovable.app">Copal.dev</vendor>

    <description><![CDATA[
    <p>Copal is your team's technical coach in the editor. It reads the project-owned <code>.copalrules</code>
    and, while you type, shows each finding as a hint card that leads with a question — the way a good pair partner would.
    Same engine as the pre-commit hook, the pull-request check and Copal MCP.</p>
    <ul>
      <li><b>Hint ladder</b> (Alt+Enter): <i>Ask me</i> (the rule's question) · <i>Explain</i> (why, team reference,
      wrong vs right) · <i>Show me</i> (the fix, only on request). Each step feeds your growth view.</li>
      <li><b>Pair on a Task</b>: before asking an AI assistant to build a feature, answer up to three navigator questions
      (first example, placement, risk); Copal writes the brief: test first, small steps.</li>
      <li><b>Practice</b>: rules that keep recurring link to a kata.</li>
      <li>Security rules stay blocking; mark a false positive with <code>copal-ignore</code>.</li>
    </ul>
    <p>Requires Node.js 20+ and the <code>copal</code> CLI.</p>
    ]]></description>

    <change-notes><![CDATA[<p>0.2.0 — coaching: hint ladder (Ask me · Explain · Show me), Copal Pair navigator tool window, kata links.</p>
    <p>0.1.0 — first sandbox release.</p>]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Registered on base languages only: dialects (TypeScript, JSX, JSON5…) inherit them. -->
        <externalAnnotator language="JavaScript" implementationClass="dev.copal.jetbrains.CopalExternalAnnotator"/>
        <externalAnnotator language="JSON" implementationClass="dev.copal.jetbrains.CopalExternalAnnotator"/>
        <externalAnnotator language="yaml" implementationClass="dev.copal.jetbrains.CopalExternalAnnotator"/>
        <externalAnnotator language="JAVA" implementationClass="dev.copal.jetbrains.CopalExternalAnnotator"/>
        <externalAnnotator language="kotlin" implementationClass="dev.copal.jetbrains.CopalExternalAnnotator"/>
        <externalAnnotator language="Python" implementationClass="dev.copal.jetbrains.CopalExternalAnnotator"/>
        <externalAnnotator language="go" implementationClass="dev.copal.jetbrains.CopalExternalAnnotator"/>
        <externalAnnotator language="TEXT" implementationClass="dev.copal.jetbrains.CopalExternalAnnotator"/>

        <applicationConfigurable parentId="tools" instance="dev.copal.jetbrains.CopalConfigurable"
                                 id="dev.copal.settings" displayName="Copal.dev"/>
        <notificationGroup id="Copal.dev" displayType="BALLOON"/>
        <toolWindow id="Copal Pair" anchor="right" factoryClass="dev.copal.jetbrains.CopalPairToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowMessages" canCloseContents="false"/>
        <toolWindow id="Copal Review" anchor="right" factoryClass="dev.copal.jetbrains.CopalReviewToolWindowFactory"
                    icon="AllIcons.Actions.Preview" canCloseContents="false"/>
    </extensions>

    <actions>
        <group id="Copal.ToolsMenu" text="Copal.dev" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Copal.PairOnTask" class="dev.copal.jetbrains.PairOnTaskAction"
                    text="Pair on a Task…" description="Navigator: answer up to 3 questions before an AI assistant builds a feature"/>
            <action id="Copal.ReviewMyChange" class="dev.copal.jetbrains.ReviewMyChangeAction"
                    text="Review My Change" description="Hint cards for your change vs the base branch, before you open a pull request (local, no server)"/>
            <action id="Copal.SyncAgentFiles" class="dev.copal.jetbrains.SyncAgentFilesAction"
                    text="Sync Agent Instruction Files" description="Write the team's rules into CLAUDE.md, AGENTS.md, Cursor and Copilot instruction files"/>
            <separator/>
            <action id="Copal.CheckStaged" class="dev.copal.jetbrains.CheckStagedAction"
                    text="Check Staged Changes" description="Run the Copal pre-commit validation on staged changes"/>
            <action id="Copal.ShowRules" class="dev.copal.jetbrains.ShowRulesAction"
                    text="Show Rules for Current File" description="Rules from .copalrules that apply to this file"/>
            <action id="Copal.Recheck" class="dev.copal.jetbrains.RecheckFileAction"
                    text="Re-check Current File"/>
            <separator/>
            <action id="Copal.SetApiKey" class="dev.copal.jetbrains.SetApiKeyAction"
                    text="Set API Key…" description="Store the Copal device key in the IDE password safe"/>
            <action id="Copal.OpenConsole" class="dev.copal.jetbrains.OpenConsoleAction"
                    text="Open Copal Console"/>
        </group>
    </actions>
</idea-plugin>
