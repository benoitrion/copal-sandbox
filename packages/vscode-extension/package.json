{
  "name": "copal-vscode",
  "displayName": "Copal.dev",
  "description": "Copal technical coach in the editor: hint cards (question, explain, show me), navigator before AI builds, katas.",
  "version": "0.3.0",
  "publisher": "copal",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "workspaceContains:.copalrules",
    "onLanguage:typescript",
    "onLanguage:javascript"
  ],
  "contributes": {
    "commands": [
      {
        "command": "copal.checkFile",
        "title": "Copal: V\u00e9rifier le fichier courant"
      },
      {
        "command": "copal.checkWorkspace",
        "title": "Copal: V\u00e9rifier le workspace"
      },
      {
        "command": "copal.setApiKey",
        "title": "Copal: D\u00e9finir la cl\u00e9 API"
      },
      {
        "command": "copal.showRules",
        "title": "Copal: Afficher les r\u00e8gles applicables"
      },
      {
        "command": "copal.pair",
        "title": "Copal: Pair on a task (navigator)"
      },
      {
        "command": "copal.ask",
        "title": "Copal: Ask me about this finding"
      },
      {
        "command": "copal.explain",
        "title": "Copal: Explain this finding"
      },
      {
        "command": "copal.showMe",
        "title": "Copal: Show me the fix"
      },
      {
        "command": "copal.syncAgentFiles",
        "title": "Copal: Sync agent instruction files (CLAUDE.md, AGENTS.md, Cursor, Copilot)"
      },
      {
        "command": "copal.reviewChange",
        "title": "Copal: Review my change"
      }
    ],
    "configuration": {
      "title": "Copal",
      "properties": {
        "copal.serverUrl": {
          "type": "string",
          "default": "http://localhost:4010",
          "description": "URL du backend Copal (mock local par d\u00e9faut). Vide = moteur local uniquement."
        },
        "copal.environment": {
          "type": "string",
          "default": "local",
          "description": "Environnement de politique (local, ci, ...)."
        },
        "copal.checkOnSave": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "scripts": {
    "package": "bash scripts-package.sh"
  },
  "dependencies": {
    "@copal/core": "0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benoitrion/copal-sandbox"
  },
  "homepage": "https://copal.lovable.app"
}
